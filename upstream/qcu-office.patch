+    nearMiss: unknown
+    allowed: unknown[]
+    attachments: Array<{ status: number }>
+    health: { status: number }
+    agent: { kind: string }
+    modelError?: string
+    calls: string[]
+    captures: number
+    httpDelegations: number
+    agentDelegations: number
+    modelDelegations: number
