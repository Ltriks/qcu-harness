{
  "name": "qcu-table-audit",
  "version": "0.2.0-prototype.8",
  "private": true,
  "type": "module",
  "main": "lib/task-host.js",
  "exports": {
    ".": "./lib/task-host.js",
    "./adapter": "./lib/index.js",
    "./task-host": "./lib/task-host.js",
    "./guidance": "./lib/guidance.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "skills",
    "README.md",
    "cordis.patch.yml",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:client": "tsc --project tsconfig.client.json --noEmit",
    "test": "vitest run --config vitest.config.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "react": "18.3.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@types/node": "22.20.0",
    "esbuild": "0.25.12",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.1.1",
    "@deepseek-ai/dsh-client-modules": "0.2.0-rc.2",
    "@types/ws": "8.18.1"
  },
  "dependencies": {
    "ws": "8.21.0"
  }
}
