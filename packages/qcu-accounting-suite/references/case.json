{
  "caseId": "fictional-accounting-classroom-v1",
  "synthetic": true,
  "currency": "CNY",
  "period": "虚构单一教学期间",
  "assumptions": [
    "期初余额为零，采用本案例自定教学科目表",
    "所有金额为整数元；不涉及税费、折旧、利润分配、坏账与期末调整",
    "设备计入固定资产、当期场地租金计入管理费用，均为本案例设定",
    "采用权责发生制与借贷记账；展示结转前试算与结转后的权益关系",
