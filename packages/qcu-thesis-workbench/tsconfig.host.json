  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowImportingTsExtensions": true, "types": ["node"], "skipLibCheck": true
  },
  "include": ["src/index.ts", "src/host/**/*.ts", "plugin/index.d.ts"]
}
