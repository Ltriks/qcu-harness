{
  "name": "qcu-expert-teams",
  "version": "0.3.0-pilot.8",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "QCU 专家团：角色、技能方法、依赖流程与教师复核",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2"
  },
  "files": [
    "build.mjs",
    "src/plugin.mjs",
    "index.js",
    "client.js",
    "src/protocol.mjs",
    "src/reports.mjs",
    "src/controller.mjs",
    "src/view.mjs",
    "src/presets.mjs",
    "src/store.mjs",
    "src/model.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "src/installed-teams.mjs",
    "src/native-launch.mjs",
    "src/unified-model.mjs",
    "src/unified-store.mjs",
    "src/unified-native.mjs",
    "src/unified-view.mjs"
  ]
}
