[Unit]
Description=QCU diagnostics HTTPS reverse proxy
After=network.target qcu-diagnostics.service

[Service]
Type=simple
ExecStartPre=/usr/bin/nginx -t -c /etc/qcu-diagnostics/nginx.conf -p /var/lib/qcu-diagnostics/proxy
ExecStart=/usr/bin/nginx -c /etc/qcu-diagnostics/nginx.conf -p /var/lib/qcu-diagnostics/proxy -g "daemon off;"
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
